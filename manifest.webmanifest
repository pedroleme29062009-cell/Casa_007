{
  "id": "/",
  "name": "Bagunça Organizada",
  "short_name": "Bagunça",
  "description": "App da família para organizar contas de casa, agenda, lista de compras, fotos e tarefas. Todos sincronizados na nuvem.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "dir": "ltr",
  "lang": "pt-BR",
  "background_color": "#1e3a8a",
  "theme_color": "#2563eb",
  "categories": ["finance", "lifestyle", "productivity"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-login.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tela de login da família"
    },
    {
      "src": "/screenshot-home.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Início com resumo e atividades"
    }
  ],
  "shortcuts": [
    {
      "name": "Início",
      "short_name": "Início",
      "description": "Abrir o resumo da casa",
      "url": "/?atalho=inicio",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Nova conta",
      "short_name": "Conta",
      "description": "Lançar entrada ou gasto",
      "url": "/?atalho=contas",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
